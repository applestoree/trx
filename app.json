{
  "app": {
    "name": "Apple Store Malaysia",
    "slug": "apple-store-malaysia",
    "version": "2.0.0",
    "description": "Mobile-first product catalog application",
    "platform": "web",
    "framework": "react-vite"
  },
  "environment": {"mode":"production","mobileOnly":true,"maxWidth":"500px"},
  "backend": {"provider":"supabase","url":"https://jhpbtooefyzdndstlzva.supabase.co","authentication":{"enabled":false,"type":"none"}},
  "api": {
    "baseUrl":"https://jhpbtooefyzdndstlzva.supabase.co/functions/v1",
    "endpoints": {"products": {"method":"GET","path":"/get-trx-products","auth":"none","jwtRequired":false,"response":{"success":true,"version":"v1","count":"number","data":"array"},"dataMapping":{"list":"data[].card","detail":"data[].productdetailpage","variants":"data[].productdetailpage.variants"},"parameters":{"item_group_id":{"type":"string","required":false,"description":"Filter product group"},"id":{"type":"string","required":false,"requires":"item_group_id","description":"Filter specific product variant"}},"queryRules":{"supported":["item_group_id","id"],"explicitlyUnsupported":["title","page","limit","offset","sort","order"],"duplicateParameter":"invalid","idWithoutItemGroupId":"invalid","otherParameters":"ignored"},"errors":{"invalidQuery":{"status":400,"code":"INVALID_QUERY","response":{"success":false,"error":{"code":"INVALID_QUERY","message":"string"}}},"methodNotAllowed":{"status":405,"code":"METHOD_NOT_ALLOWED"},"serverConfigError":{"status":500,"code":"SERVER_CONFIG_ERROR"},"databaseError":{"status":500,"code":"DATABASE_ERROR"}}}}
  },
  "data": {"source":"api.products","apiResponse":{"catalog":"data[].card","productDetail":"data[].productdetailpage","variants":"data[].productdetailpage.variants"},"grouping":{"key":"item_group_id","description":"The Edge Function groups trx_products rows by item_group_id and returns one card plus one productdetailpage per group."},"cardSelection":{"rule":"lowest effective price","effectivePrice":"sale_price when present, otherwise price","imageSource":"selected variant image_link"}},
  "database": {"source":"trx_products","fields":{"product":["item_group_id","title","description","availability","condition","brand","google_product_category","product_type","custom_label_0","custom_label_1","custom_label_2"],"variant":["id","link","image_link","additional_image_link","variant_color","variant_size","price","sale_price"]}},
  "routes": [
    {"path":"/","name":"Home","component":"HomePage"},
    {"path":"/products","name":"Products","component":"ProductListPage"},
    {"path":"/products?item_group_id=:item_group_id","name":"Product Detail","component":"ProductDetailPage"},
    {"path":"/products?item_group_id=:item_group_id&variantsId=:variantsId","name":"Product Detail Variant","component":"ProductDetailPage"},
    {"path":"/cart","name":"Cart","component":"CartPage"},
    {"path":"/checkout","name":"Checkout","component":"CheckoutPage"},
    {"path":"/profile","name":"Profile","component":"ProfilePage"}
  ],
  "navigation": {"header":{"enabled":true,"logo":true,"cart":true},"bottomNavigation":{"enabled":true,"items":[{"label":"Home","icon":"home","path":"/"},{"label":"Products","icon":"grid","path":"/products"},{"label":"Cart","icon":"shopping-bag","path":"/cart"},{"label":"Profile","icon":"user","path":"/profile"}]}},
  "pages": {
    "HomePage":{"layout":"default","components":["Header","HeroBanner","CategoryList","FeaturedProducts","ProductGrid"]},
    "ProductListPage":{"layout":"default","components":["Header","SearchBar","CategoryFilter","ProductGrid"]},
    "ProductDetailPage":{"layout":"default","components":["Header","ProductImageGallery","ProductInfo","PriceDisplay","AvailabilityBadge","VariantSelector","AddToCartButton"]},
    "CartPage":{"layout":"default","components":["Header","CartItemList","CartSummary","CheckoutButton"]},
    "CheckoutPage":{"layout":"default","components":["Header","CustomerForm","OrderSummary","PaymentMethod","PlaceOrderButton"]},
    "ProfilePage":{"layout":"default","components":["Header","ProfileInfo","OrderHistory"]}
  },
  "components": {
    "ProductGrid":{"type":"grid","columns":2,"dataSource":"api.products.data[].card"},
    "ProductCard":{"dataSource":"api.products.data[].card","fields":["item_group_id","title","image_link","price","sale_price","product_type","custom_label_0","custom_label_1","custom_label_2"],"actions":["viewDetail","addToCart"]},
    "ProductImageGallery":{"dataSource":"api.products.data[].productdetailpage.variants[].variant_color","fields":["image_link","additional_image_link"],"imageSource":"variant_color.image_link","additionalImageSource":"variant_color.additional_image_link"},
    "VariantSelector":{"dataSource":"api.products.data[].productdetailpage.variants","fields":["id","link","variant_color","variant_size"]},
    "AddToCartButton":{"action":"cart.addItem","afterAction":"openCart"},
    "SkeletonNotFound":{"type":"emptyOrErrorState","displayWhen":["products not found","api.products.data is empty","product API request fails"]}
  },
  "state": {
    "cart":{"persist":true,"storage":"localStorage","fields":["productId","item_group_id","title","image","price","sale_price","quantity","variant"],"fieldSource":{"productId":"internal frontend cart identifier; not provided by the product API","item_group_id":"api.products.data[].card.item_group_id or productdetailpage.item_group_id","title":"API product title","image":"API variant image","price":"API variant price","sale_price":"API variant sale_price","quantity":"internal cart state","variant":"API productdetailpage.variants entry"}},
    "user":{"persist":true,"storage":"localStorage"}
  },
  "businessRules": {
    "productAvailability":{"source":"api.products.data[].productdetailpage.availability","behavior":"Use the backend-provided availability value without assuming an enum not defined by the Edge Function."},
    "pricing":{"displaySalePrice":true,"fallbackPrice":"price"},
    "cart":{"minimumQuantity":1,"maximumQuantity":10},
    "productDetail":{"query":{"required":["item_group_id"],"optional":["id","variantsId"]},"apiExamples":{"product":"/get-trx-products?item_group_id=<item_group_id>","variant":"/get-trx-products?item_group_id=<item_group_id>&id=<id>"}},
    "variant":{"selectedBy":"id","imageSource":"variant_color.image_link","additionalImageSource":"variant_color.additional_image_link","priceSource":"variant_size.price","salePriceSource":"variant_size.sale_price","backendLinkSource":"link","backendLinkFormat":"/products?item_group_id=<item_group_id>&variantsId=<id>","apiFilterParameter":"id"},
    "search":{"mode":"client-side","source":"api.products.data[].card","apiSearchParameter":false},
    "filter":{"mode":"client-side","source":"api.products.data[].card","apiFilterParameters":["item_group_id","id"]}
  },
  "theme": {"style":"apple-inspired","mode":"light","colors":{"primary":"#007AFF","background":"#F5F5F7","surface":"#FFFFFF","text":"#1D1D1F","muted":"#86868B","border":"#E5E5E7"},"layout":{"maxWidth":"500px","borderRadius":"16px","spacing":"compact"}},
  "features": {"search":true,"filter":true,"cart":true,"checkout":true,"authentication":false,"darkMode":false,"pwa":true,"variants":true,"salePrice":true},
  "security": {"frontendSecrets":false,"jwtRequired":false,"serviceRoleKeyInFrontend":false,"cors":true},
  "rules": [
    "Mobile-first responsive design",
    "Maximum application width is 500px",
    "API is the source of truth for product data",
    "Do not use mock product data",
    "Do not use hardcoded product data",
    "Do not use fallback product data",
    "API failure must not fallback to mock or hardcoded product data",
    "If products are not found, display Skeleton Not Found",
    "If the API returns an empty data array, display Skeleton Not Found",
    "If the product API request fails, display Skeleton Not Found",
    "GET /get-trx-products is the only product data source",
    "Catalog must use data[].card",
    "Product detail must use data[].productdetailpage",
    "Variants must use data[].productdetailpage.variants",
    "Product images must use variants[].variant_color.image_link and variants[].variant_color.additional_image_link",
    "Product card selection follows the Edge Function lowest effective price rule",
    "Effective price is sale_price when present, otherwise price",
    "Product detail requires item_group_id",
    "id may only be sent together with item_group_id",
    "Only item_group_id and id are supported API filters",
    "Do not send explicitly unsupported API query parameters",
    "Do not send duplicate query parameters",
    "Unknown query parameters are not used as product filters",
    "Search must be client-side and must not send title as an API search parameter",
    "Filtering must be client-side unless using the supported item_group_id or id API parameters",
    "Use backend-provided availability values without inventing availability enums",
    "Use the backend-provided variant link when navigating from a variant",
    "The backend variant link uses variantsId, while the API filter parameter is id",
    "productId in cart is an internal frontend identifier and is not an API product field",
    "Do not use service_role key in frontend",
    "Do not add product fields that are not provided by the API",
    "Do not add features not defined in this blueprint"
  ]
}